stateDiagram-v2
    [*] --> UploadDocuments
    UploadDocuments --> ExtractData : Files Sent to Backend
    ExtractData --> DataValidation : LLM returns JSON
    DataValidation --> RunTier0Gates : Structure validated
    
    state RunTier0Gates {
        [*] --> IdentityGate
        IdentityGate --> ClinicalFirewall : Pass
        IdentityGate --> Blocked : Fail
        ClinicalFirewall --> Tier0Complete : Pass
    }
    
    RunTier0Gates --> RunFinancialRules : If Tier0Complete
    RunTier0Gates --> Finalize : If Blocked
    
    state RunFinancialRules {
        [*] --> ProportionateDeduction
        ProportionateDeduction --> CrossDocumentAdjudication
        CrossDocumentAdjudication --> UpdateLedger
    }
    
    RunFinancialRules --> FinancialReconciliation
    FinancialReconciliation --> GenerateAppeal : If Discrepancy Found
    FinancialReconciliation --> Finalize : If No Discrepancy
    GenerateAppeal --> Finalize
    
    Finalize --> [*]
